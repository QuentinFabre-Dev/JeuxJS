# --- Access -------------------------------------------------------------
# Shared password protecting the whole site. Leave it empty in local
# development: authentication is then disabled entirely and `npm run dev`
# opens straight onto the app. Set it anywhere the site is reachable from the
# internet, or the API key behind it is effectively public.
SITE_PASSWORD=

# --- Spending guard rails ------------------------------------------------
# A password decides who gets in; these decide how much they may burn.
# The per-request caps are hard: a review beyond them is refused before any
# call is made. The rate limit is best effort — it counts in the memory of one
# serverless instance and resets on a cold start. The real backstop is a
# monthly spend limit set on the OpenAI account itself.
# MAX_PAGES=80
# MAX_CALLS_PER_REVIEW=200
# REVIEWS_PER_HOUR=30

# --- OpenAI (the checks that need a model) -------------------------------
# Read only by the server. NEVER prefix it with NEXT_PUBLIC_ — those variables
# are inlined into the bundle served to the browser and would be public.
OPENAI_API_KEY=

# Number of model calls in flight at once. Higher is faster until the API
# starts answering 429; the review then finishes later, never in error.
# ANALYSIS_CONCURRENCY=12

# Model tiers. The mechanical pass (spelling, grammar) does not need the
# reasoning tier: the small one is five times cheaper and faster for the same
# result. Override only if the evaluation bench says otherwise.
# ANALYSIS_MODEL_MAIN=gpt-5
# ANALYSIS_MODEL_FAST=gpt-5-mini

# --- Local development engines ------------------------------------------
# Ollama, still reachable in development through /ollama.
OLLAMA_HOST=http://127.0.0.1:11434

# DeepSeek, kept as a cloud fallback. Server-side only, same rule as above.
DEEPSEEK_API_KEY=
# DEEPSEEK_HOST=https://api.deepseek.com

# Optional: defaults shown in the browser before the user changes them.
# NEXT_PUBLIC_OLLAMA_MODEL=llama3.1:8b

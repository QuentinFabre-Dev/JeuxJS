# Ollama server the Vite dev proxy forwards to (server-side, no rebuild needed).
OLLAMA_HOST=http://127.0.0.1:11434

# DeepSeek API key, used as a cloud fallback when the local model is not
# available. Read by the Vite dev server and injected into the /deepseek proxy:
# it never reaches the browser. NEVER prefix it with VITE_ — those variables are
# inlined into the bundle and would be public.
DEEPSEEK_API_KEY=

# Optional: point the DeepSeek proxy elsewhere (tests, a compatible gateway).
# DEEPSEEK_HOST=https://api.deepseek.com

# Optional: defaults shown in the browser before the user changes them in the UI.
# VITE_OLLAMA_MODEL=llama3.1:8b
# VITE_OLLAMA_BASE_URL=/ollama
